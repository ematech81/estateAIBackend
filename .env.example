# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string — never commit the real value
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/estateai

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# AI provider (Anthropic Claude) — used for AI-assisted listing extraction
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-5

# CORS — frontend origin allowed to call this API
WEB_ORIGIN=http://localhost:3000

# Cloudinary — used for signed direct-to-Cloudinary photo uploads on listings
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo — transactional email (password reset links). Get an API key at
# app.brevo.com/settings/keys/api. Sender email must be a verified sender
# in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

